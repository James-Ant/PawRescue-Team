<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PawRescue.Mobile.Views"
                xmlns:vm="clr-namespace:PawRescue.Mobile.ViewModels"
                x:Class="PawRescue.Mobile.Views.ForgotPasswordPage"
                x:DataType="vm:ForgotPasswordViewModel"
                Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="24,16" Spacing="8">
            <Label Text="🔑" FontSize="48" HorizontalOptions="Center" />
            <Label Text="Forgot your password?" Style="{StaticResource Title}" HorizontalOptions="Center" />
            <Label Text="We'll send a 6-digit code to your email." Style="{StaticResource Caption}" HorizontalOptions="Center" Margin="0,0,0,12" />

            <Label Text="Email" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputBorder}">
                <Entry Text="{Binding Email}" Placeholder="you@example.com" Keyboard="Email" IsEnabled="{Binding IsRequestStep}" />
            </Border>

            <Button Text="Send Code" Command="{Binding SendCodeCommand}" IsVisible="{Binding IsRequestStep}" Margin="0,12,0,0" />

            <!-- Step 2 -->
            <VerticalStackLayout IsVisible="{Binding IsCodeSent}" Spacing="8">
                <Label Text="6-digit code" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputBorder}">
                    <Entry Text="{Binding Code}" Placeholder="123456" Keyboard="Numeric" MaxLength="6" />
                </Border>

                <Label Text="New password" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputBorder}">
                    <Entry Text="{Binding NewPassword}" Placeholder="At least 8 characters" IsPassword="True" />
                </Border>

                <Button Text="Reset Password" Command="{Binding ResetCommand}" Margin="0,12,0,0" />
                <Button Text="Resend code" Style="{StaticResource OutlineButton}" Command="{Binding SendCodeCommand}" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
