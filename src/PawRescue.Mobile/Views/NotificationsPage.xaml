<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PawRescue.Mobile.Views"
                xmlns:vm="clr-namespace:PawRescue.Mobile.ViewModels"
                xmlns:m="clr-namespace:PawRescue.Mobile.Models"
                x:Class="PawRescue.Mobile.Views.NotificationsPage"
                x:DataType="vm:NotificationsViewModel"
                Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Mark all read" Command="{Binding MarkAllReadCommand}" />
    </ContentPage.ToolbarItems>

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
        <CollectionView ItemsSource="{Binding Items}" SelectionMode="Single" SelectedItem="{Binding SelectedItem}">
            <CollectionView.Header>
                <BoxView HeightRequest="8" Color="Transparent" />
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="m:NotificationDto">
                    <Grid Padding="16,4" Style="{StaticResource NoSelectionHighlight}">
                        <Border Style="{StaticResource Card}" BackgroundColor="{Binding IsRead, Converter={StaticResource ReadToBackground}}">
                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                                <Border WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 22" StrokeThickness="0"
                                        BackgroundColor="{StaticResource PrimaryLight}" VerticalOptions="Start">
                                    <Label Text="{Binding Icon}" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding Title}" FontAttributes="Bold" />
                                    <Label Text="{Binding Message}" Style="{StaticResource Caption}" FontSize="14" />
                                    <Label Text="{Binding CreatedAt, Converter={StaticResource UtcToLocal}}" Style="{StaticResource Caption}" FontSize="11" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" WidthRequest="10" HeightRequest="10" StrokeShape="RoundRectangle 5" StrokeThickness="0"
                                        BackgroundColor="{StaticResource Primary}" VerticalOptions="Start"
                                        IsVisible="{Binding IsRead, Converter={StaticResource InvertedBool}}" />
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="32" Spacing="6" HorizontalOptions="Center">
                    <Label Text="🔔" FontSize="44" HorizontalOptions="Center" />
                    <Label Text="You're all caught up" Style="{StaticResource SectionTitle}" HorizontalOptions="Center" />
                    <Label Text="Rescue updates and nearby alerts will show up here." Style="{StaticResource Caption}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
    </RefreshView>
</views:BasePage>
