<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PawRescue.Mobile.Views"
                xmlns:vm="clr-namespace:PawRescue.Mobile.ViewModels"
                x:Class="PawRescue.Mobile.Views.HomePage"
                x:DataType="vm:HomeViewModel"
                Shell.NavBarIsVisible="False">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
        <CollectionView ItemsSource="{Binding NearbyReports}"
                        ItemTemplate="{StaticResource ReportCardTemplate}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedReport}">

            <CollectionView.Header>
                <VerticalStackLayout Padding="16,20,16,4" Spacing="16">

                    <!-- Top bar: greeting + bell -->
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource Caption}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Greeting}" />
                                        <Span Text=", " />
                                        <Span Text="{Binding UserName}" />
                                        <Span Text=" 👋" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Text="Help animals near you" Style="{StaticResource Title}" FontSize="22" />
                            <Label Text="{Binding LocationText, StringFormat='📍 {0}'}" Style="{StaticResource Caption}"
                                   MaxLines="1" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>

                        <Grid Grid.Column="1" WidthRequest="46" HeightRequest="46" VerticalOptions="Start">
                            <Border BackgroundColor="{StaticResource Surface}" StrokeShape="RoundRectangle 23" Stroke="{StaticResource Border}">
                                <Image Source="tab_bell.png" WidthRequest="22" HeightRequest="22" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenNotificationsCommand}" />
                                </Border.GestureRecognizers>
                            </Border>
                            <Border BackgroundColor="{StaticResource Danger}" StrokeShape="RoundRectangle 9" StrokeThickness="0"
                                    WidthRequest="18" HeightRequest="18" HorizontalOptions="End" VerticalOptions="Start"
                                    IsVisible="{Binding UnreadCount, Converter={StaticResource CountToBool}}">
                                <Label Text="{Binding UnreadCount}" TextColor="White" FontSize="10" FontAttributes="Bold"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Hero call-to-action -->
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 22" Padding="20">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource Primary}" Offset="0" />
                                <GradientStop Color="{StaticResource PrimaryDark}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="See an animal in need?" TextColor="White" FontSize="19" FontAttributes="Bold" />
                                <Label Text="Snap a photo and we'll pin it on the map for rescuers." TextColor="#FFEDD5" FontSize="13" />
                                <Button Text="📷  Report Now" BackgroundColor="White" TextColor="{StaticResource Primary}"
                                        HeightRequest="42" CornerRadius="12" HorizontalOptions="Start" Margin="0,8,0,0"
                                        Command="{Binding ReportAnimalCommand}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="🐕" FontSize="64" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Quick actions -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Border Style="{StaticResource StatCard}">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding NearbyReports.Count}" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
                                <Label Text="Nearby" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource StatCard}">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding UrgentCount}" FontSize="22" FontAttributes="Bold"
                                       TextColor="{StaticResource SeverityCritical}" HorizontalOptions="Center" />
                                <Label Text="Urgent" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource StatCard}" BackgroundColor="{StaticResource SecondaryLight}">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                <Label Text="🗺️" FontSize="22" HorizontalOptions="Center" />
                                <Label Text="Open map" Style="{StaticResource Caption}" TextColor="{StaticResource Secondary}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenMapCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>

                    <!-- Role shortcuts -->
                    <Button Text="🦺  Volunteer Dashboard" Style="{StaticResource SecondaryButton}"
                            IsVisible="{Binding IsVolunteer}" Command="{Binding OpenVolunteerDashboardCommand}" />
                    <Button Text="🛠️  Admin Dashboard" Style="{StaticResource OutlineButton}"
                            IsVisible="{Binding IsAdmin}" Command="{Binding OpenAdminDashboardCommand}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Animals near you" Style="{StaticResource SectionTitle}" />
                        <Label Grid.Column="1" Text="See map" Style="{StaticResource LinkLabel}" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenMapCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="32" Spacing="8" HorizontalOptions="Center">
                    <Label Text="🐾" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="No animals reported nearby" Style="{StaticResource SectionTitle}" HorizontalOptions="Center" />
                    <Label Text="That's good news! Pull down to refresh." Style="{StaticResource Caption}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.Footer>
                <BoxView HeightRequest="24" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>
    </RefreshView>
</views:BasePage>
